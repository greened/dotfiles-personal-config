# Personal git entry point (symlinked to ~/.gitconfig by this overlay's link.sh).
#
# Three layers, later winning over earlier:
#
#   1. ~/lib/dotfiles/git/gitconfig   the generic tracked base
#   2. ~/.gitconfig.overlays          GENERATED by link.sh: one include line per
#                                     overlay's git/config present on this
#                                     machine (identity, company settings)
#   3. ~/.gitconfig.local             HAND-WRITTEN, for settings true of ONE
#                                     machine and no other
#
# Layer 2 is a build artifact -- link.sh truncates and regenerates it on every
# run, so anything hand-written there is lost. It used to be called
# `.gitconfig.local`, which is the conventional name for layer 3 and made the two
# easy to confuse; the generated one was renamed rather than the hand-written
# one.
#
# Layer 3 is untracked and ungenerated, and git skips the include entirely when
# the file is absent -- so a machine that needs nothing carries nothing. First
# use: the Mac's `credential.helper = pass-git-helper`, which needs the homebrew
# bin on PATH. That path exists on no other machine, and a hardcoded
# /opt/homebrew in a tracked file is exactly what this layer prevents.
[include]
	path = ~/lib/dotfiles/git/gitconfig
	path = ~/.gitconfig.overlays
	path = ~/.gitconfig.local
[core]
	# Global hook dispatcher: chains to any repo-local hook, and strips AI
	# co-author trailers on non-work (personal) repos. See git/hooks/_chain.
	hooksPath = ~/lib/dotfiles-overlays/personal-config/git/hooks
# Per-location author identity. Repos under personal roots use dag@obbligato.org
# (GitHub: greened); everything else defaults to the work identity in
# ~/.gitconfig.overlays. The pre-commit hook (git/hooks/_chain) is the backstop that
# also covers greened-origin repos outside these paths.
[includeIf "gitdir:~/src/"]
	path = ~/lib/dotfiles-overlays/personal-config/git/identity-personal
[includeIf "gitdir:~/projects/"]
	path = ~/lib/dotfiles-overlays/personal-config/git/identity-personal
[includeIf "gitdir:~/lib/"]
	path = ~/lib/dotfiles-overlays/personal-config/git/identity-personal
