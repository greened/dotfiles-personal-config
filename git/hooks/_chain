#!/usr/bin/env bash
# Global git hook dispatcher, pointed at by core.hooksPath (set in the personal
# gitconfig overlay). Symlinked as commit-msg, pre-commit, etc.
#
# It does two things, in order:
#   1. Chains to the repo's OWN hook of the same name (in <gitdir>/hooks), so a
#      global hooksPath does not silently disable per-repo hooks.
#   2. Applies personal policy: on personal repos, strip AI co-author trailers
#      (Claude / anthropic) from the commit message. Work repos keep their
#      trailers untouched. Human co-authors are never stripped.
#
# Rationale: personal repos must never carry an AI trailer; this enforces it
# deterministically instead of relying on the author (human or agent) to remember.
set -euo pipefail
hook="$(basename "$0")"

# Where the work signals that NAME the employer live.  Not in this file: this
# repo is published, and a list of "these are my employer's org and mail domain"
# sitting in a published personal repo is the leak the scrub below protects
# against.  Same reasoning and same shape as the scrub's term list.
hook_realm_file() {
  local f
  f="$(git config --get realm.workFile 2>/dev/null || true)"
  [ -n "$f" ] || f="$HOME/.config/git-realm-work"
  printf '%s' "$f"
}

# First value of a single-valued rule (e.g. `identity') from that file.
hook_realm_value() {
  local f line
  f="$(hook_realm_file)"
  [ -r "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in
      "$1 "*) printf '%s' "${line#"$1" }" | tr -d '[:space:]'; return 0 ;;
    esac
  done < "$f"
}

# Which realm is this repo in?  Echoes "personal" or "work".
#
# Last match wins, deliberately: a work origin or work email says work, and a
# greened origin or a personal path root says personal and overrides it -- a
# personal repo cloned under a work checkout root still commits as personal.
# Factored out because three policies below ask the same question, and three
# copies of a last-match-wins chain is three chances to answer it differently.
#
# A MISSING signal file fails CLOSED: no work origin is recognised, so a work
# repo looks personal, the scrub runs and trailers are stripped.  That
# over-applies the personal rules rather than leaking.
hook_realm() {
  local origin email top realm f line kind glob
  origin="$(git config --get remote.origin.url 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  realm=personal
  f="$(hook_realm_file)"
  if [ -r "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      kind="${line%% *}"; glob="${line#* }"
      [ -n "$kind" ] && [ "$kind" != "$line" ] || continue
      case "$kind" in
        origin) case "$origin" in $glob) realm=work ;; esac ;;
        email)  case "$email"  in $glob) realm=work ;; esac ;;
      esac
    done < "$f"
  fi
  # No work-signal file means, in the ordinary case, a machine with no work
  # context at all -- a personal laptop with only the personal overlays cloned.
  # Nothing is missing there, so nothing is said: every repo reading as personal
  # is the correct posture, and a notice on every commit would be pure noise.
  # It used to warn here, which on such a machine fires forever and teaches you
  # to scroll past the one place this hook ever speaks.
  #
  # The awkward case is a WORK machine that has lost the file: its work repos
  # then read as personal, so the scrub runs on them and fails closed rather
  # than leaking.  Loud but wrong-headed at commit time; that belongs to the
  # work overlay's link.sh, which checks its own deployment (see the term-list
  # check there).
  case "$top/"   in "$HOME"/ws/*) realm=work ;; esac
  case "$top/"   in "$HOME"/src/*|"$HOME"/projects/*|"$HOME"/lib/*) realm=personal ;; esac
  # A repo owned by the work GitHub ACCOUNT is work-realm even when the local
  # identity is personal and the checkout sits outside any work path root --
  # account ownership is the distinguisher, not visibility or location.  That is
  # what memory-personal and skills-personal are: private repos on the work
  # account, holding work-tiered content.  Without this they defaulted to
  # personal and the scrub rejected any Jira key, which is most of what they
  # store.  Matched by the account's trailing `-cb' owner segment rather than
  # spelled out, since the shape rule below would flag the handle itself.
  case "$origin" in *[:/]*-cb/*) realm=work ;; esac
  case "$origin" in *[:/]greened/*) realm=personal ;; esac
  printf '%s' "$realm"
}

# 1) Chain to the repo-local hook of the same name, if present and not ourselves.
#
# TWO git dirs, not one.  Inside a linked worktree `--absolute-git-dir` returns
# <main>/.git/worktrees/<name>, which has no hooks/ of its own, so checking only
# that path silently skipped every repo-local hook in a worktree -- the place
# most of the work happens.  Measured 2026-09-04 in a scratch repo: an ordinary
# branch switch DID run the repo-local post-checkout, and `git worktree add` did
# NOT.  `--git-common-dir` is the main .git, where hooks/ actually lives.
self="$(cd "$(dirname "$0")" && pwd)/$hook"
ran_local=""
for gitdir in \
  "$(git rev-parse --absolute-git-dir 2>/dev/null || true)" \
  "$(git rev-parse --git-common-dir 2>/dev/null || true)"
do
  [ -n "$gitdir" ] || continue
  # --git-common-dir can come back RELATIVE (a bare ".git"), so absolutize it
  # before comparing, or the dedup misses and a repo-local hook runs twice.
  gitdir="$(cd "$gitdir" 2>/dev/null && pwd || true)"
  [ -n "$gitdir" ] || continue
  local_hook="$gitdir/hooks/$hook"
  [ -x "$local_hook" ] || continue
  [ "$local_hook" != "$self" ] || continue
  [ "$local_hook" != "$ran_local" ] || continue
  ran_local="$local_hook"
  "$local_hook" "$@" || exit $?
done

# 1b) post-checkout: remind that a NEW WORKTREE still has to be wired into the
#     memory system.  `git be wt add` cannot be covered here -- it goes through
#     git-project, whose add_worktree calls pygit2, and libgit2 runs no hooks
#     (measured 2026-09-04: the git CLI fired this hook, pygit2 did not).  So the
#     skill covers that path and this covers plain `git worktree add`.
#
#     PRINT ONLY, always exit 0.  A failing post-checkout would break
#     `git worktree add` itself, and a reminder is not worth that.
#
#     The guard is two facts and no path assumptions:
#       - $1 is the null SHA  -> a fresh checkout, not a branch switch
#       - the two git dirs differ -> this is a LINKED WORKTREE, not a main clone
#     Together they fire exactly once, when a worktree is created.
if [ "$hook" = "post-checkout" ]; then
  old="${1:-}"
  wire="$HOME/.claude/skills-personal/bin/wt-wire.sh"
  case "$old" in
    0000000000000000000000000000000000000000)
      adg="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
      cdg="$(git rev-parse --git-common-dir 2>/dev/null || true)"
      cdg="$(cd "$cdg" 2>/dev/null && pwd || true)"
      if [ -n "$adg" ] && [ -n "$cdg" ] && [ "$adg" != "$cdg" ] && [ -x "$wire" ]; then
        name="$(basename "$PWD")"
        owner="$(basename "$(dirname "$PWD")")"
        # DO the decision-free half, remind about the rest.
        #
        # `--slugs-only` creates the slug directory and nothing else. It is
        # instant, needs no answer from anyone, and writes to no other git repo.
        # That is the omission that costs the FIRST session all of its memory,
        # and the next sync-skills-personal tick runs bootstrap and wires it.
        #
        # The other two steps deliberately stay out of here. Full wiring runs
        # bootstrap, which takes 66 seconds (measured) -- unacceptable to block
        # `git worktree add` on. And declaring the unit can need a question when
        # the name looks like an existing stack; a hook has nowhere to ask, so it
        # would either guess (the silent split this whole design prevents) or
        # fail, and a failing post-checkout breaks `git worktree add` itself.
        #
        # Hence `|| true`: a wiring problem must never break the checkout.
        #
        # Only claim a slug when one really happened. A worktree outside the ws
        # root gets none, and saying otherwise is the kind of plausible-but-wrong
        # output that hides the real state.
        wired="$("$wire" --slugs-only "$owner/$name" 2>/dev/null || true)"
        case "$wired" in
          *"slug:"*)
            echo "post-checkout: worktree '$name' has no declared UNIT yet." >&2
            echo "  Its slug is in place, so the next sync tick gives it project memory." >&2
            echo "  To put it in a unit (idempotent):  $wire $owner/$name" >&2
            ;;
        esac
      fi
      ;;
  esac
fi

# 2) commit-msg policy: strip AI trailers unless this is a work repo.
if [ "$hook" = "commit-msg" ]; then
  msg="$1"
  if [ "$(hook_realm)" = personal ]; then
    tmp="$(mktemp)"
    # Drop AI co-author/assisted-by lines only (keep human co-authors).
    grep -viE '^(co-authored-by|assisted-by):[[:space:]].*(claude|anthropic)' "$msg" > "$tmp" || true
    # Remove any blank lines left dangling at the end.
    awk '{a[NR]=$0} END{n=NR; while(n>0 && a[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print a[i]}' "$tmp" > "$msg"
    rm -f "$tmp"
  fi
fi

# 3) pre-commit policy: ensure the author identity matches the repo's realm.
#    Personal -> David Greene <dag@obbligato.org> (GitHub greened); work -> the
#    `identity' address from the work-signal file, which is where the employer
#    address lives so this published file does not carry it.  Backs up the
#    includeIf rules in gitconfig (which cover the personal path roots).
#
#    No identity rule = no work address to enforce, so the check is SKIPPED for
#    work repos rather than rewriting them to the personal address, which would
#    be the wrong direction and would misattribute work commits.
if [ "$hook" = "pre-commit" ]; then
  want_name="David Greene"
  if [ "$(hook_realm)" = work ]; then
    want_email="$(hook_realm_value identity)"
  else
    want_email="dag@obbligato.org"
  fi
  cur_email="$(git config user.email 2>/dev/null || true)"
  if [ "$cur_email" != "$want_email" ]; then
    git config user.name "$want_name"
    git config user.email "$want_email"
    echo "identity: set author to $want_name <$want_email> for this repo; re-run your commit." >&2
    exit 1
  fi
fi

# 3b) pre-commit policy: FORMAT the staged lines rather than checking them.
#
#     A check-only gate turns a zero-effort fix into a failed commit plus a
#     manual format plus a retry: three interactions to avoid one automatic
#     edit.  So this formats, and it always succeeds.  It may or may not change
#     the code.
#
#     Not at build time.  A build should observe the source, not mutate it:
#     reformatting there breaks the property that a build result describes the
#     tree you have, leaves a dirty worktree behind, and can write back over NFS
#     from a compute node.
#
#     It runs BEFORE the two scans below, deliberately.  Both refuse a commit
#     based on staged content, so they should judge the bytes that will actually
#     land, not the bytes as typed.
#
#     STAGED LINES ONLY, through git-clang-format, never `clang-format -i' on
#     whole files.  Three reasons: whole-file formatting drags in pre-existing
#     violations that must stay untouched, it reflows code nobody wrote, and it
#     forces a directory allowlist that goes stale (the allowlist this replaces
#     had missed a whole subtree).  Line-scoped formatting can run repo-wide
#     with no churn, so there is nothing to keep in step.
#
#     NOTHING here names a project, or a path inside one: this repo is
#     published, and the scrub below would refuse the commit anyway.  The pinned
#     binary is named by per-clone config, or by TOOLCHAIN when the environment
#     already carries it.  Neither present means silence, which is right on a
#     machine that has no such toolchain -- but a config that names a MISSING
#     binary is loud, because that is a broken install and not an absent one.
#
#     Pinning matters: clang-format versions disagree, and an unpinned one from
#     PATH reflows whole files.  Never resolve it from PATH.
if [ "$hook" = "pre-commit" ]; then
  fmt_bin="$(git config --get format.clangFormatBin 2>/dev/null || true)"
  fmt_named="$fmt_bin"
  if [ -z "$fmt_bin" ] && [ -n "${TOOLCHAIN:-}" ]; then
    fmt_bin="$TOOLCHAIN/sdk-x86_64/usr/bin/clang-format"
  fi
  # git-clang-format ships in the LLVM tree, so its presence is also the test
  # for "is this the kind of clone this policy is about".  No tree, no policy.
  #
  # The tool itself is NOT what does the work, and that is a measured decision.
  # `git clang-format --staged' picks the changed lines from the index but
  # formats and patches the WORKING TREE, so on a partially staged file its
  # hunk carries the unstaged lines as context and will not apply to the index
  # at all (measured 2026-09-09: the staged line went in unformatted).  What
  # follows formats the staged BLOB and writes that back, which is the thing
  # the commit is actually made from.
  fmt_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  fmt_gcf=""
  [ -n "$fmt_top" ] && fmt_gcf="$fmt_top/clang/tools/clang-format/git-clang-format"

  if [ -n "$fmt_named" ] && [ ! -x "$fmt_named" ]; then
    echo "format: format.clangFormatBin names $fmt_named, which is not executable." >&2
    echo "format: staged lines were NOT formatted.  Fix the path or unset it." >&2
  elif [ -n "$fmt_bin" ] && [ -x "$fmt_bin" ] && [ -n "$fmt_gcf" ] && [ -r "$fmt_gcf" ]; then
    # An initial commit has no HEAD to diff against, so fall back to the empty
    # tree rather than skipping: a first commit deserves the same treatment.
    fmt_base=HEAD
    git rev-parse --verify -q HEAD >/dev/null 2>&1 || \
      fmt_base="$(git hash-object -t tree /dev/null)"
    fmt_touched=0
    fmt_split=0

    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx) ;;
        # Extension-based, so a C++ header that carries no filename extension
        # at all is not covered.  Stated rather than left to be discovered:
        # letting clang-format decide instead would hand it every staged file
        # in the repo.
        *) continue ;;
      esac
      # Regular files only.  A symlink's blob is its target text, and
      # reformatting that would corrupt the link.
      fmt_mode="$(git ls-files --stage -- "$f" | awk '{print $1; exit}')"
      case "$fmt_mode" in 100644|100755) ;; *) continue ;; esac

      # The changed line ranges IN THE STAGED CONTENT, from the +side of each
      # hunk header.  A pure deletion (+a,0) has no lines to format.
      fmt_lines="$(git diff --cached -U0 --diff-filter=ACM "$fmt_base" -- "$f" 2>/dev/null \
                     | sed -n 's/^@@ -[0-9,]* +\([0-9]*\),\{0,1\}\([0-9]*\) @@.*/\1 \2/p')"
      [ -n "$fmt_lines" ] || continue
      fmt_args=()
      while read -r start count; do
        [ -n "$start" ] || continue
        [ -n "$count" ] || count=1
        [ "$count" -gt 0 ] 2>/dev/null || continue
        fmt_args+=("--lines=$start:$((start + count - 1))")
      done <<< "$fmt_lines"
      [ "${#fmt_args[@]}" -gt 0 ] || continue

      fmt_was="$(mktemp)"; fmt_now="$(mktemp)"
      if git show ":$f" > "$fmt_was" 2>/dev/null &&
         "$fmt_bin" --assume-filename="$f" "${fmt_args[@]}" < "$fmt_was" > "$fmt_now" 2>/dev/null &&
         [ -s "$fmt_now" ] && ! cmp -s "$fmt_was" "$fmt_now"
      then
        fmt_sha="$(git hash-object -w --path="$f" "$fmt_now" 2>/dev/null || true)"
        if [ -n "$fmt_sha" ] && git update-index --cacheinfo "$fmt_mode,$fmt_sha,$f" 2>/dev/null; then
          fmt_touched=$((fmt_touched + 1))
          # Update the file on disk ONLY when it still matches what was staged.
          # If it does not, the difference is unstaged work, and overwriting it
          # is the data loss this whole approach exists to avoid.
          if cmp -s "$fmt_was" "$f" 2>/dev/null; then
            cat "$fmt_now" > "$f"
          else
            fmt_split=$((fmt_split + 1))
          fi
        fi
      fi
      rm -f "$fmt_was" "$fmt_now"
    done < <(git diff --cached --name-only --diff-filter=ACM "$fmt_base" 2>/dev/null)

    if [ "$fmt_touched" -gt 0 ]; then
      echo "format: reformatted staged lines in $fmt_touched file(s)." >&2
      if [ "$fmt_split" -gt 0 ]; then
        echo "format: $fmt_split of them also had UNSTAGED edits, so only the" >&2
        echo "format: commit was formatted -- the file on disk was left alone." >&2
      fi
    fi
  fi
fi

# 4) pre-commit policy: refuse to commit a staged line that looks like a live
#    credential.
#
#    Scans ADDED LINES ONLY, not whole files, for two reasons: it stays fast on a
#    big repo, and a file that legitimately documents a credential SHAPE does not
#    re-flag on every later commit. Patterns require a realistic secret length, so
#    prose like `Authorization: token ghp_...` is not a hit while a real 36-char
#    token is.
#
#    Rationale: same as the commit-msg policy above. On 2026-08-28 a sync pass ran
#    this exact scan by hand as `grep -lE ... && echo HITS`, printed its banner,
#    and then staged, committed and pushed the flagged file anyway, because a
#    reporting side effect is not a gate. A hook cannot be forgotten.
if [ "$hook" = "pre-commit" ]; then
  secret_re='(ghp_|gho_|ghu_|ghs_|ghr_)[A-Za-z0-9]{20,}'
  secret_re="$secret_re"'|github_pat_[A-Za-z0-9_]{20,}'
  secret_re="$secret_re"'|xox[bpsa]-[A-Za-z0-9][A-Za-z0-9-]{9,}'
  secret_re="$secret_re"'|AKIA[0-9A-Z]{16}'
  secret_re="$secret_re"'|sk-ant-[A-Za-z0-9_-]{20,}'
  secret_re="$secret_re"'|-----BEGIN [A-Z ]*PRIVATE KEY-----'

  secret_fail=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # -a: treat as text; a staged binary should not abort the scan.
    added="$(git diff --cached -U0 --diff-filter=ACM -- "$f" 2>/dev/null \
               | grep -a '^+' | grep -av '^+++' || true)"
    [ -n "$added" ] || continue
    matched="$(printf '%s\n' "$added" | grep -aoE "$secret_re" || true)"
    if [ -n "$matched" ]; then
      secret_fail=1
      echo "secret-scan: possible credential in staged $f" >&2
      # Never echo the secret: show only enough to identify the kind.
      printf '%s\n' "$matched" | sed -E 's/(.{10}).*/  \1<redacted>/' | sort -u >&2
    fi
  done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

  if [ "$secret_fail" -ne 0 ]; then
    echo "secret-scan: refusing to commit. Remove the credential and re-stage." >&2
    echo "secret-scan: if this is a documented example, shorten it so it cannot" >&2
    echo "             be mistaken for a live value (e.g. ghp_... not 36 chars)." >&2
    exit 1
  fi
fi
# 5) pre-commit / pre-push policy: refuse to put EMPLOYER information into a
#    personal repo.
#
#    Two halves, because they fail differently.
#
#    LITERAL terms -- the company name, internal repo and subsystem names,
#    colleague logins -- are read from ~/.config/git-scrub-terms (override with
#    `git config scrub.termsFile'), deployed there from a PRIVATE overlay.  They
#    cannot live in a public repo: a list of "these are my employer's internal
#    names" published in a personal repo IS the leak it protects against.
#    One term per line, blank lines and # comments ignored, matched
#    case-insensitively as extended regexps.
#
#    SHAPE rules are built in here, because they generalise and name nobody:
#    a work-account handle suffix, a Jira-style key, the work NFS root.
#
#    This is a RATCHET, not a guarantee.  On 2026-09-01 a full history scrub of
#    prevue took five passes: each one caught what the last had missed, because
#    a deny-list only ever catches what you already knew to look for.  The names
#    that got through -- a colleague login nobody had written down, an internal
#    filename, a branch name -- were found by sweeping for SHAPE and position,
#    not by name.  So: add every term you ever find to the file, and keep
#    running a deliberate sweep before anything is published.  What this hook
#    buys is that no leak you have already found can happen twice.
#
#    A personal repo can be EXEMPT from the scrub without leaving the personal
#    realm.  One case exists: the overlay holding an employer's own
#    configuration, where those terms are the point of the repo rather than a
#    leak.  Exempting it must not flip the realm, because realm also decides
#    that AI trailers get stripped and that the author is the personal
#    identity, and both of those still apply there.
#
#    Which repos are exempt is read from ~/.config/git-scrub-exempt (override
#    with `git config scrub.exemptFile'), deployed there from the same PRIVATE
#    overlay that carries the term list and for the same reason: saying "this
#    repo is the employer-shaped one" names the employer, so it can live in a
#    private repo but never in a public one.  One shell glob per line, matched
#    against remote.origin.url.  A missing file means no exemptions, which is
#    the safe direction.  An exemption announces itself on every commit, so it
#    cannot become something you forgot was switched on.
hook_scrub_exempt() {
  local f origin line
  f="$(git config --get scrub.exemptFile 2>/dev/null || true)"
  [ -n "$f" ] || f="$HOME/.config/git-scrub-exempt"
  [ -r "$f" ] || { printf '0'; return 0; }
  origin="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$origin" ] || { printf '0'; return 0; }
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [ -n "$line" ] || continue
    # shellcheck disable=SC2254
    case "$origin" in $line) printf '1'; return 0 ;; esac
  done < "$f"
  printf '0'
}

if [ "$hook" = "pre-commit" ] || [ "$hook" = "pre-push" ]; then
  if [ "$(hook_realm)" = personal ] && [ "$(hook_scrub_exempt)" = 1 ]; then
    echo "scrub: this repo is exempt -- employer terms are its purpose." >&2
    echo "scrub: trailer-stripping and the personal identity still apply." >&2
  elif [ "$(hook_realm)" = personal ]; then
    terms_file="$(git config --get scrub.termsFile 2>/dev/null || true)"
    [ -n "$terms_file" ] || terms_file="$HOME/.config/git-scrub-terms"

    # Rules first: both the shape pair and `scrub_term_re' come from
    # scrub-rules.sh, and the term regex below is built by calling it.
    #
    # The shape rules name no employer, so they are safe in a repo-visible file.
    # Plain ERE plus an exclusion filter, not a PCRE lookahead, so it is the
    # same pair each project's check.sh runs (which must survive a CI image
    # whose grep may lack PCRE).  Those copies remain, because they run where
    # this file is not available, and they are still kept in step by hand.
    #
    # What this DOES remove is the copy the guard would otherwise hold:
    # scrub-selftest.sh sources the same file, so it asserts against the rules
    # and the term builder the hook actually uses rather than lookalikes.
    #
    # A missing file fails CLOSED.  The scrub is what stands between a personal
    # repo and employer information, so a broken install must stop the commit,
    # not wave it through with nothing checked.
    rules="$(cd "$(dirname "$0")" && pwd)/scrub-rules.sh"
    if [ ! -r "$rules" ]; then
      echo "scrub: cannot read $rules -- refusing." >&2
      echo "scrub: without the shape rules, nothing is being checked." >&2
      exit 1
    fi
    # shellcheck source=scrub-rules.sh
    . "$rules"

    # A missing term list means different things on different machines, and the
    # signal that tells them apart is whether this machine has work context at
    # all -- the realm file, which ships in the same private overlay as the term
    # list and is therefore present or absent WITH it.
    #
    #   no work context   A personal machine: no work overlay, no work
    #                     material, nothing expected.  The shape rules still
    #                     run, and they need no employer names.  Silent, and
    #                     the commit proceeds -- being told on every commit
    #                     about a list you have no reason to own is how a
    #                     warning becomes invisible.
    #   work context      The overlay is here but its list is not: a broken
    #                     install, which is the state one machine sat in
    #                     unnoticed for weeks while the scrub reported success
    #                     having checked no names.  REFUSE.
    #
    # The escape is per-checkout, so switching it on is a deliberate act
    # recorded in that repo rather than a global flag, and it announces itself
    # on every commit for the same reason the exempt list does.
    scrub_re=''
    if [ -r "$terms_file" ]; then
      scrub_re="$(scrub_term_re "$terms_file")"
    elif [ ! -r "$(hook_realm_file)" ]; then
      : # no work context; shape rules only, and nothing to say about it
    elif [ "$(git config --get --type=bool scrub.allowNoTerms 2>/dev/null)" = true ]; then
      echo "scrub: no term list, allowed by scrub.allowNoTerms in this repo." >&2
      echo "scrub: employer NAMES are unchecked here; shape rules still run." >&2
    else
      echo "!! ==================================================" >&2
      echo "!! scrub: NO TERM LIST -- refusing to commit" >&2
      echo "!!   expected: $terms_file" >&2
      echo "!!   This machine HAS work context (the realm file is here), so" >&2
      echo "!!   the list should be too -- its overlay deploys both.  With it" >&2
      echo "!!   missing, employer names are not checked at all." >&2
      echo "!!   Fix the overlay's install, or, to proceed anyway:" >&2
      echo "!!     git config scrub.allowNoTerms true" >&2
      echo "!! ==================================================" >&2
      exit 1
    fi


    if [ "$hook" = "pre-commit" ]; then
      changed="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"
      added_of() { git diff --cached -U0 --diff-filter=ACM -- "$1" 2>/dev/null \
                     | grep -a '^+' | grep -av '^+++' || true; }
    else
      # pre-push: everything this push would publish that the remote lacks
      remote_head="$(git rev-parse --verify -q "@{u}" 2>/dev/null || true)"
      range="${remote_head:+$remote_head..}HEAD"
      changed="$(git diff --name-only --diff-filter=ACM "$range" 2>/dev/null)"
      added_of() { git diff -U0 --diff-filter=ACM "$range" -- "$1" 2>/dev/null \
                     | grep -a '^+' | grep -av '^+++' || true; }
    fi

    scrub_fail=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      added="$(added_of "$f")"
      [ -n "$added" ] || continue
      # Two passes, and the case sensitivity is the point.  Shape rules are
      # case-SENSITIVE: matched with -i, the Jira-key rule fires on any
      # lowercase hyphen-digits string ("abc-1234"), which is everywhere.
      # Literal terms are case-INSENSITIVE, since a name is a name however it
      # is capitalised.
      # The trailing `true' is load-bearing under `set -e': with no term list
      # `scrub_re' is empty, the `if' is the group's last command, and a group
      # ending in a false test makes the whole substitution non-zero, which
      # aborts the commit -- silently, since the warning above looks like the
      # only thing that happened.
      hits="$( { printf '%s\n' "$added" | sed -E "$shape_skip" \
                   | grep -aoE "$shape_re" 2>/dev/null || true
                 if [ -n "$scrub_re" ]; then
                   printf '%s\n' "$added" | grep -aoiE "$scrub_re" 2>/dev/null || true
                 fi
                 true
               } | sort -u )"
      if [ -n "$hits" ]; then
        scrub_fail=1
        echo "scrub: employer information in $f" >&2
        printf '%s\n' "$hits" | sed 's/^/  /' >&2
      fi
    done < <(printf '%s\n' "$changed")

    if [ "$scrub_fail" -ne 0 ]; then
      echo "scrub: refusing -- this is a personal repo." >&2
      echo "scrub: use a fictional stand-in (the repos use acme/..., alice, bob)." >&2
      echo "scrub: a genuine false positive means narrowing the rule, not skipping it." >&2
      exit 1
    fi
  fi
fi
exit 0
