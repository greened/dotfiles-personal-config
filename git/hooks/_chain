#!/usr/bin/env bash
# Global git hook dispatcher, pointed at by core.hooksPath (set in the personal
# gitconfig overlay). Symlinked as commit-msg, pre-commit, etc.
#
# It does two things, in order:
#   1. Chains to the repo's OWN hook of the same name (in <gitdir>/hooks), so a
#      global hooksPath does not silently disable per-repo hooks.
#   2. Applies personal policy: on personal repos, strip AI co-author trailers
#      (Claude / anthropic) from the commit message. Work repos keep their
#      trailers untouched. Human co-authors are never stripped.
#
# Rationale: personal repos must never carry an AI trailer; this enforces it
# deterministically instead of relying on the author (human or agent) to remember.
set -euo pipefail
hook="$(basename "$0")"

# Where the work signals that NAME the employer live.  Not in this file: this
# repo is published, and a list of "these are my employer's org and mail domain"
# sitting in a published personal repo is the leak the scrub below protects
# against.  Same reasoning and same shape as the scrub's term list.
hook_realm_file() {
  local f
  f="$(git config --get realm.workFile 2>/dev/null || true)"
  [ -n "$f" ] || f="$HOME/.config/git-realm-work"
  printf '%s' "$f"
}

# First value of a single-valued rule (e.g. `identity') from that file.
hook_realm_value() {
  local f line
  f="$(hook_realm_file)"
  [ -r "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in
      "$1 "*) printf '%s' "${line#"$1" }" | tr -d '[:space:]'; return 0 ;;
    esac
  done < "$f"
}

# Which realm is this repo in?  Echoes "personal" or "work".
#
# Last match wins, deliberately: a work origin or work email says work, and a
# greened origin or a personal path root says personal and overrides it -- a
# personal repo cloned under a work checkout root still commits as personal.
# Factored out because three policies below ask the same question, and three
# copies of a last-match-wins chain is three chances to answer it differently.
#
# A MISSING signal file fails CLOSED: no work origin is recognised, so a work
# repo looks personal, the scrub runs and trailers are stripped.  That
# over-applies the personal rules rather than leaking.
hook_realm() {
  local origin email top realm f line kind glob
  origin="$(git config --get remote.origin.url 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  realm=personal
  f="$(hook_realm_file)"
  if [ -r "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      kind="${line%% *}"; glob="${line#* }"
      [ -n "$kind" ] && [ "$kind" != "$line" ] || continue
      case "$kind" in
        origin) case "$origin" in $glob) realm=work ;; esac ;;
        email)  case "$email"  in $glob) realm=work ;; esac ;;
      esac
    done < "$f"
  else
    echo "realm: no work-signal file at $f -- employer origins NOT recognised," >&2
    echo "realm: so every repo is treated as personal.  See git config realm.workFile." >&2
  fi
  case "$top/"   in "$HOME"/ws/*) realm=work ;; esac
  case "$top/"   in "$HOME"/src/*|"$HOME"/projects/*|"$HOME"/lib/*) realm=personal ;; esac
  # A repo owned by the work GitHub ACCOUNT is work-realm even when the local
  # identity is personal and the checkout sits outside any work path root --
  # account ownership is the distinguisher, not visibility or location.  That is
  # what memory-personal and skills-personal are: private repos on the work
  # account, holding work-tiered content.  Without this they defaulted to
  # personal and the scrub rejected any Jira key, which is most of what they
  # store.  Matched by the account's trailing `-cb' owner segment rather than
  # spelled out, since the shape rule below would flag the handle itself.
  case "$origin" in *[:/]*-cb/*) realm=work ;; esac
  case "$origin" in *[:/]greened/*) realm=personal ;; esac
  printf '%s' "$realm"
}

# 1) Chain to the repo-local hook of the same name, if present and not ourselves.
gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
if [ -n "$gitdir" ]; then
  local_hook="$gitdir/hooks/$hook"
  self="$(cd "$(dirname "$0")" && pwd)/$hook"
  if [ -x "$local_hook" ] && [ "$local_hook" != "$self" ]; then
    "$local_hook" "$@" || exit $?
  fi
fi

# 2) commit-msg policy: strip AI trailers unless this is a work repo.
if [ "$hook" = "commit-msg" ]; then
  msg="$1"
  if [ "$(hook_realm)" = personal ]; then
    tmp="$(mktemp)"
    # Drop AI co-author/assisted-by lines only (keep human co-authors).
    grep -viE '^(co-authored-by|assisted-by):[[:space:]].*(claude|anthropic)' "$msg" > "$tmp" || true
    # Remove any blank lines left dangling at the end.
    awk '{a[NR]=$0} END{n=NR; while(n>0 && a[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print a[i]}' "$tmp" > "$msg"
    rm -f "$tmp"
  fi
fi

# 3) pre-commit policy: ensure the author identity matches the repo's realm.
#    Personal -> David Greene <dag@obbligato.org> (GitHub greened); work -> the
#    `identity' address from the work-signal file, which is where the employer
#    address lives so this published file does not carry it.  Backs up the
#    includeIf rules in gitconfig (which cover the personal path roots).
#
#    No identity rule = no work address to enforce, so the check is SKIPPED for
#    work repos rather than rewriting them to the personal address, which would
#    be the wrong direction and would misattribute work commits.
if [ "$hook" = "pre-commit" ]; then
  want_name="David Greene"
  if [ "$(hook_realm)" = work ]; then
    want_email="$(hook_realm_value identity)"
  else
    want_email="dag@obbligato.org"
  fi
  cur_email="$(git config user.email 2>/dev/null || true)"
  if [ "$cur_email" != "$want_email" ]; then
    git config user.name "$want_name"
    git config user.email "$want_email"
    echo "identity: set author to $want_name <$want_email> for this repo; re-run your commit." >&2
    exit 1
  fi
fi

# 4) pre-commit policy: refuse to commit a staged line that looks like a live
#    credential.
#
#    Scans ADDED LINES ONLY, not whole files, for two reasons: it stays fast on a
#    big repo, and a file that legitimately documents a credential SHAPE does not
#    re-flag on every later commit. Patterns require a realistic secret length, so
#    prose like `Authorization: token ghp_...` is not a hit while a real 36-char
#    token is.
#
#    Rationale: same as the commit-msg policy above. On 2026-08-28 a sync pass ran
#    this exact scan by hand as `grep -lE ... && echo HITS`, printed its banner,
#    and then staged, committed and pushed the flagged file anyway, because a
#    reporting side effect is not a gate. A hook cannot be forgotten.
if [ "$hook" = "pre-commit" ]; then
  secret_re='(ghp_|gho_|ghu_|ghs_|ghr_)[A-Za-z0-9]{20,}'
  secret_re="$secret_re"'|github_pat_[A-Za-z0-9_]{20,}'
  secret_re="$secret_re"'|xox[bpsa]-[A-Za-z0-9][A-Za-z0-9-]{9,}'
  secret_re="$secret_re"'|AKIA[0-9A-Z]{16}'
  secret_re="$secret_re"'|sk-ant-[A-Za-z0-9_-]{20,}'
  secret_re="$secret_re"'|-----BEGIN [A-Z ]*PRIVATE KEY-----'

  secret_fail=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # -a: treat as text; a staged binary should not abort the scan.
    added="$(git diff --cached -U0 --diff-filter=ACM -- "$f" 2>/dev/null \
               | grep -a '^+' | grep -av '^+++' || true)"
    [ -n "$added" ] || continue
    matched="$(printf '%s\n' "$added" | grep -aoE "$secret_re" || true)"
    if [ -n "$matched" ]; then
      secret_fail=1
      echo "secret-scan: possible credential in staged $f" >&2
      # Never echo the secret: show only enough to identify the kind.
      printf '%s\n' "$matched" | sed -E 's/(.{10}).*/  \1<redacted>/' | sort -u >&2
    fi
  done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

  if [ "$secret_fail" -ne 0 ]; then
    echo "secret-scan: refusing to commit. Remove the credential and re-stage." >&2
    echo "secret-scan: if this is a documented example, shorten it so it cannot" >&2
    echo "             be mistaken for a live value (e.g. ghp_... not 36 chars)." >&2
    exit 1
  fi
fi
# 5) pre-commit / pre-push policy: refuse to put EMPLOYER information into a
#    personal repo.
#
#    Two halves, because they fail differently.
#
#    LITERAL terms -- the company name, internal repo and subsystem names,
#    colleague logins -- come from a file OUTSIDE any repo (default
#    ~/.config/git-scrub-terms, override with `git config scrub.termsFile').
#    They cannot be committed anywhere: a list of "these are my employer's
#    internal names" living in a personal repo IS the leak it protects against.
#    One term per line, blank lines and # comments ignored, matched
#    case-insensitively as extended regexps.
#
#    SHAPE rules are built in here, because they generalise and name nobody:
#    a work-account handle suffix, a Jira-style key, the work NFS root.
#
#    This is a RATCHET, not a guarantee.  On 2026-09-01 a full history scrub of
#    prevue took five passes: each one caught what the last had missed, because
#    a deny-list only ever catches what you already knew to look for.  The names
#    that got through -- a colleague login nobody had written down, an internal
#    filename, a branch name -- were found by sweeping for SHAPE and position,
#    not by name.  So: add every term you ever find to the file, and keep
#    running a deliberate sweep before anything is published.  What this hook
#    buys is that no leak you have already found can happen twice.
#
#    A personal repo can be EXEMPT from the scrub without leaving the personal
#    realm.  One case exists: the overlay holding an employer's own
#    configuration, where those terms are the point of the repo rather than a
#    leak.  Exempting it must not flip the realm, because realm also decides
#    that AI trailers get stripped and that the author is the personal
#    identity, and both of those still apply there.
#
#    Which repos are exempt lives outside any repo (default
#    ~/.config/git-scrub-exempt, override with `git config scrub.exemptFile'),
#    for the same reason the term list does: saying "this repo is the
#    employer-shaped one" names the employer.  One shell glob per line, matched
#    against remote.origin.url.  A missing file means no exemptions, which is
#    the safe direction.  An exemption announces itself on every commit, so it
#    cannot become something you forgot was switched on.
hook_scrub_exempt() {
  local f origin line
  f="$(git config --get scrub.exemptFile 2>/dev/null || true)"
  [ -n "$f" ] || f="$HOME/.config/git-scrub-exempt"
  [ -r "$f" ] || { printf '0'; return 0; }
  origin="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$origin" ] || { printf '0'; return 0; }
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [ -n "$line" ] || continue
    # shellcheck disable=SC2254
    case "$origin" in $line) printf '1'; return 0 ;; esac
  done < "$f"
  printf '0'
}

if [ "$hook" = "pre-commit" ] || [ "$hook" = "pre-push" ]; then
  if [ "$(hook_realm)" = personal ] && [ "$(hook_scrub_exempt)" = 1 ]; then
    echo "scrub: this repo is exempt -- employer terms are its purpose." >&2
    echo "scrub: trailer-stripping and the personal identity still apply." >&2
  elif [ "$(hook_realm)" = personal ]; then
    terms_file="$(git config --get scrub.termsFile 2>/dev/null || true)"
    [ -n "$terms_file" ] || terms_file="$HOME/.config/git-scrub-terms"

    scrub_re=''
    if [ -r "$terms_file" ]; then
      # strip comments and blanks, join with |
      scrub_re="$(sed -e 's/#.*$//' -e 's/[[:space:]]*$//' "$terms_file" \
                    | grep -v '^[[:space:]]*$' | paste -sd'|' -)"
    else
      echo "scrub: no term list at $terms_file -- literal terms NOT checked." >&2
      echo "scrub: create it (one term per line) or set scrub.termsFile." >&2
    fi

    # Shape rules: no employer name in them, so they are safe in a repo-visible
    # file.  Plain ERE plus an exclusion filter, not a PCRE lookahead, so it is
    # the same pair each project's check.sh runs (which must survive a CI image
    # whose grep may lack PCRE).  Those copies remain, because they run where
    # this file is not available, and they are still kept in step by hand.
    #
    # What this DOES remove is the copy the guard would otherwise hold:
    # scrub-selftest.sh sources the same file, so it asserts against the rules
    # the hook actually enforces rather than a lookalike.
    #
    # A missing file fails CLOSED.  The scrub is what stands between a personal
    # repo and employer information, so a broken install must stop the commit,
    # not wave it through with nothing checked.
    rules="$(cd "$(dirname "$0")" && pwd)/scrub-rules.sh"
    if [ ! -r "$rules" ]; then
      echo "scrub: cannot read $rules -- refusing." >&2
      echo "scrub: without the shape rules, nothing is being checked." >&2
      exit 1
    fi
    # shellcheck source=scrub-rules.sh
    . "$rules"


    if [ "$hook" = "pre-commit" ]; then
      changed="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"
      added_of() { git diff --cached -U0 --diff-filter=ACM -- "$1" 2>/dev/null \
                     | grep -a '^+' | grep -av '^+++' || true; }
    else
      # pre-push: everything this push would publish that the remote lacks
      remote_head="$(git rev-parse --verify -q "@{u}" 2>/dev/null || true)"
      range="${remote_head:+$remote_head..}HEAD"
      changed="$(git diff --name-only --diff-filter=ACM "$range" 2>/dev/null)"
      added_of() { git diff -U0 --diff-filter=ACM "$range" -- "$1" 2>/dev/null \
                     | grep -a '^+' | grep -av '^+++' || true; }
    fi

    scrub_fail=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      added="$(added_of "$f")"
      [ -n "$added" ] || continue
      # Two passes, and the case sensitivity is the point.  Shape rules are
      # case-SENSITIVE: matched with -i, the Jira-key rule fires on any
      # lowercase hyphen-digits string ("abc-1234"), which is everywhere.
      # Literal terms are case-INSENSITIVE, since a name is a name however it
      # is capitalised.
      # The trailing `true' is load-bearing under `set -e': with no term list
      # `scrub_re' is empty, the `if' is the group's last command, and a group
      # ending in a false test makes the whole substitution non-zero, which
      # aborts the commit -- silently, since the warning above looks like the
      # only thing that happened.
      hits="$( { printf '%s\n' "$added" | sed -E "$shape_skip" \
                   | grep -aoE "$shape_re" 2>/dev/null || true
                 if [ -n "$scrub_re" ]; then
                   printf '%s\n' "$added" | grep -aoiE "$scrub_re" 2>/dev/null || true
                 fi
                 true
               } | sort -u )"
      if [ -n "$hits" ]; then
        scrub_fail=1
        echo "scrub: employer information in $f" >&2
        printf '%s\n' "$hits" | sed 's/^/  /' >&2
      fi
    done < <(printf '%s\n' "$changed")

    if [ "$scrub_fail" -ne 0 ]; then
      echo "scrub: refusing -- this is a personal repo." >&2
      echo "scrub: use a fictional stand-in (the repos use acme/..., alice, bob)." >&2
      echo "scrub: a genuine false positive means narrowing the rule, not skipping it." >&2
      exit 1
    fi
  fi
fi
exit 0
